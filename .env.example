NEXT_PUBLIC_STORE_URL=http://localhost:3000

# Server-only PriyasaCore API root. The browser uses the same-origin /api/priyasa proxy.
PRIYASA_API_BASE_URL=http://localhost:8000/api/v1

# Public Razorpay key used by the browser checkout. Never put the Razorpay secret here.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx

# Firebase Web Push / FCM public configuration. These are safe browser-side values.
NEXT_PUBLIC_FIREBASE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_VAPID_KEY=BMxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_APP_VERSION=1.0.0

# Legacy server-side compatibility variable. PRIYASA_API_BASE_URL takes precedence.
PRIYASA_API_URL=http://localhost:8000/api/v1
